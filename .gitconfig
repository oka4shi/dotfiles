[user]
    signingkey = AA0160C051AEE60D
    email = primary@oka4shi.dev
    name = OKAMOTO Shigehiro

[init]
    defaultbranch = main

[core]
    editor = vim

[commit]
    gpgsign = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[alias]
    amend = commit --amend
    l = log --oneline --graph --decorate -n 10
