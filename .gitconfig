[user]
    signingkey = AA0160C051AEE60D
    email = primary@oka4shi.dev
    name = OKAMOTO Shigehiro

[init]
    defaultbranch = main

[core]
    editor = vim
    sshCommand = env SSH_ASKPASS_REQUIRE=never ssh

[commit]
    gpgsign = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[alias]
    amend = commit --amend
    l = log --oneline --graph --decorate -n 10
